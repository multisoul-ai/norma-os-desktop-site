{
  "name": "norma-os-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "demo:media": "bash scripts/process-demo-media.sh",
    "deploy:production": "pnpm exec vercel pull --yes --environment=production --token \"$VERCEL_TOKEN\" && pnpm exec vercel build --prod --token \"$VERCEL_TOKEN\" && pnpm exec vercel deploy --prebuilt --prod --token \"$VERCEL_TOKEN\"",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "58.0.0",
    "vitest": "^4.1.7"
  }
}
